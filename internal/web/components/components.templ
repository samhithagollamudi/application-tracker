package components

import (
	"fmt"
	"strings"

	"github.com/ChandraShekar2001/application-tracker/internal/model"
)

// Field is a labelled text-like input. cls adds grid classes ("full", "span2").
templ Field(label, name, value, typ, placeholder, cls, err string) {
	<label class={ "f", cls, templ.KV("has-err", err != "") }>
		{ label }
		<input name={ name } type={ typ } value={ value } placeholder={ placeholder } aria-invalid?={ err != "" }/>
		if err != "" {
			<span class="err">{ err }</span>
		}
	</label>
}

// Select is a labelled dropdown. blank is the empty option's text ("" = no empty option).
templ Select(label, name, value string, opts []model.Option, blank, err string) {
	<label class={ "f", templ.KV("has-err", err != "") }>
		{ label }
		<select name={ name }>
			if blank != "" {
				<option value="">{ blank }</option>
			}
			for _, o := range opts {
				<option value={ o.Value } selected?={ o.Value == value }>{ o.Label }</option>
			}
		</select>
		if err != "" {
			<span class="err">{ err }</span>
		}
	</label>
}

templ TextArea(label, name, value, cls, err string) {
	<label class={ "f", cls, templ.KV("has-err", err != "") }>
		{ label }
		<textarea name={ name }>{ value }</textarea>
		if err != "" {
			<span class="err">{ err }</span>
		}
	</label>
}

templ StatusBadge(status string) {
	<span class={ "badge", model.StatusClass(status) }>{ model.StatusLabel(status) }</span>
}

func stepIndex(status string) int {
	for i, s := range model.ProgressSteps {
		if s.Value == status {
			return i
		}
	}
	return -1
}

func dotClass(i, k int) string {
	switch {
	case i < 0:
		return "dot"
	case k < i:
		return "dot done"
	case k == i:
		return "dot now"
	}
	return "dot"
}

templ Steps(status string) {
	<ol class="steps" aria-label="Progress">
		for k, s := range model.ProgressSteps {
			<li><span class={ dotClass(stepIndex(status), k) }></span>{ s.Label }</li>
		}
	</ol>
}

templ Dash(v string) {
	if v == "" {
		<span class="muted">—</span>
	} else {
		{ v }
	}
}

templ KV(label, value string) {
	<div>
		<dt>{ label }</dt>
		<dd>
			@Dash(value)
		</dd>
	</div>
}

func msSummary(anyLabel string, opts []model.Option, selected []string) string {
	var picked []string
	for _, o := range opts {
		if model.In(o.Value, selected) {
			picked = append(picked, o.Label)
		}
	}
	switch len(picked) {
	case 0:
		return anyLabel
	case 1, 2:
		return strings.Join(picked, ", ")
	default:
		return fmt.Sprintf("%s +%d", picked[0], len(picked)-1)
	}
}

// MultiSelect is a dropdown of checkboxes sending repeated name=value params.
// Built on <details>, so it opens and submits even without JS; app.js keeps
// the summary text current, closes it on outside clicks and filters long lists.
templ MultiSelect(label, name, anyLabel string, opts []model.Option, selected []string) {
	<div class="f">
		<span>{ label }</span>
		<details class="ms" data-ms data-any={ anyLabel }>
			<summary aria-label={ label + ": " + msSummary(anyLabel, opts, selected) }>
				<span data-ms-label class={ templ.KV("ms-on", len(selected) > 0) }>{ msSummary(anyLabel, opts, selected) }</span>
			</summary>
			<div class="ms-panel">
				if len(opts) > 8 {
					<input type="search" class="ms-search" placeholder={ "Find " + strings.ToLower(label) } aria-label={ "Find " + strings.ToLower(label) } data-ms-search/>
				}
				for _, o := range opts {
					<label class="ms-opt">
						<input type="checkbox" name={ name } value={ o.Value } checked?={ model.In(o.Value, selected) }/>
						<span>{ o.Label }</span>
					</label>
				}
				if len(opts) == 0 {
					<span class="small muted" style="padding:8px 12px">Nothing to choose yet</span>
				}
			</div>
		</details>
	</div>
}
