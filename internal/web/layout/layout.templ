package layout

// NavItem is one entry in the sidebar.
type NavItem struct {
	Key   string
	Label string
	Href  string
}

// Shell describes the signed-in chrome around a page. A nil *Shell renders a bare page (e.g. login).
type Shell struct {
	RoleLabel string // e.g. "Consultant · Chennai"
	RoleClass string // "role-consultant" (purple) or "role-other" (blue)
	UserName  string
	UserEmail string
	Items     []NavItem
	Active    string // NavItem.Key that is highlighted
	CSRFToken string
}

templ Base(title string, csrf string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if csrf != "" {
				<meta name="csrf-token" content={ csrf }/>
			}
			<title>{ title } · SNY Cosmos Tracker</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Page(title string, s *Shell) {
	if s == nil {
		@Base(title, "") {
			{ children... }
		}
	} else {
		@Base(title, s.CSRFToken) {
			<div class="shell">
				<aside class="side">
					<img class="logo-img" src="/static/logo.png" alt="SNY Cosmos Overseas"/>
					<div class={ "role", s.RoleClass }>{ s.RoleLabel }</div>
					<nav class="nav" aria-label="Main">
						for _, it := range s.Items {
							if it.Key == s.Active {
								<a href={ templ.SafeURL(it.Href) } class="on" aria-current="page">{ it.Label }</a>
							} else {
								<a href={ templ.SafeURL(it.Href) }>{ it.Label }</a>
							}
						}
					</nav>
					<div class="me">
						<strong>{ s.UserName }</strong>
						<span>{ s.UserEmail }</span>
						<form method="post" action="/logout" style="margin-top:8px">
							<input type="hidden" name="csrf_token" value={ s.CSRFToken }/>
							<button class="lnk" type="submit">Sign out</button>
						</form>
					</div>
				</aside>
				<main>
					{ children... }
				</main>
			</div>
		}
	}
}
