package layout

import (
	"github.com/ChandraShekar2001/application-tracker/internal/web/static"
	"github.com/ChandraShekar2001/application-tracker/internal/model"
	"github.com/ChandraShekar2001/application-tracker/internal/reqctx"
)

type NavItem struct {
	Key   string
	Label string
	Href  string
}

func navItems(u *model.User) []NavItem {
	if u.IsAdmin() {
		return []NavItem{
			{"applications", "Applications", "/applications"},
			{"students", "Students", "/students"},
			{"catalog", "Universities & consultancies", "/admin/catalog"},
			{"users", "Users & branches", "/admin/users"},
			{"exports", "Exports", "/exports"},
		}
	}
	label := "Students"
	if u.Role == model.RoleConsultant {
		label = "My students"
	}
	return []NavItem{
		{"students", label, "/students"},
		{"new", "New student", "/students/new"},
	}
}

func roleClass(u *model.User) string {
	if u.Role == model.RoleConsultant {
		return "role-consultant"
	}
	return "role-other"
}

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ reqctx.CSRF(ctx) }/>
			<title>{ title } · SNY Cosmos Tracker</title>
			<link rel="icon" type="image/svg+xml" href={ "/static/favicon.svg?v=" + static.Version }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/>
			<link rel="stylesheet" href={ "/static/app.css?v=" + static.Version }/>
			<script src={ "/static/htmx.min.js?v=" + static.Version } defer></script>
			<script src={ "/static/app.js?v=" + static.Version } defer></script>
		</head>
		<body>
			{ children... }
			if f := reqctx.Flash(ctx); f != "" {
				<div class="toast" role="status" data-toast>{ f }</div>
			}
		</body>
	</html>
}

// CSRF is the hidden field every POST form must include.
templ CSRF() {
	<input type="hidden" name="csrf_token" value={ reqctx.CSRF(ctx) }/>
}

// Page renders the signed-in shell (sidebar + main) around the content.
// active is the NavItem key to highlight.
templ Page(title string, active string) {
	@Base(title) {
		if u := reqctx.User(ctx); u != nil {
			<div class="shell">
				<aside class="side">
					<a href="/"><img class="logo-img" src={ "/static/logo.png?v=" + static.Version } alt="SNY Cosmos Overseas"/></a>
					<div class={ "role", roleClass(u) }>{ u.RoleLabel() }</div>
					<nav class="nav" aria-label="Main">
						for _, it := range navItems(u) {
							if it.Key == active {
								<a href={ templ.SafeURL(it.Href) } class="on" aria-current="page">{ it.Label }</a>
							} else {
								<a href={ templ.SafeURL(it.Href) }>{ it.Label }</a>
							}
						}
					</nav>
					<div class="me">
						<strong>{ u.Name }</strong>
						<span>{ u.Email }</span>
						<form method="post" action="/logout" style="margin-top:8px">
							@CSRF()
							<button class="lnk" type="submit">Sign out</button>
						</form>
					</div>
				</aside>
				<main>
					{ children... }
				</main>
			</div>
			if u.IsAdmin() {
				<div id="notices" class="notices" aria-live="polite"></div>
				<div hx-get="/exports/notify" hx-trigger="load delay:1s, every 4s" hx-target="#notices" hx-swap="beforeend"></div>
			}
		} else {
			<main style="max-width:560px;margin:80px auto;padding:0 16px">
				{ children... }
			</main>
		}
	}
}
