package pages

import "github.com/ChandraShekar2001/application-tracker/internal/web/layout"

templ Error(status int, title, message string) {
	@layout.Page(title, "") {
		<div class="card">
			<h1>{ title }</h1>
			<p class="sub">{ message }</p>
			<p><a href="/">Back to the tracker</a></p>
		</div>
	}
}

templ Login(email, errMsg string) {
	@layout.Base("Sign in") {
		<div class="login">
			<section class="left">
				<div class="small b" style="letter-spacing:.14em;text-transform:uppercase;color:#F1DDF2">SNY Cosmos Overseas</div>
				<h1 style="font-size:40px;line-height:1.1">Application Tracker</h1>
				<p>Track every student and university application across all branches and the agent network. Sign in with the user ID and password your admin gave you.</p>
			</section>
			<section class="right">
				<div class="box">
					<form class="card" method="post" action="/login">
						@layout.CSRF()
						<img src="/static/logo.png" alt="SNY Cosmos Overseas" style="width:220px;height:auto"/>
						<h2>Sign in</h2>
						<label class="f">
							User ID
							<input name="email" type="email" autocomplete="username" placeholder="name@snycosmos.com" value={ email } required autofocus?={ email == "" }/>
						</label>
						<label class="f">
							Password
							<input name="password" type="password" autocomplete="current-password" required autofocus?={ email != "" }/>
						</label>
						if errMsg != "" {
							<div class="small b" role="alert" style="color:#A12622">{ errMsg }</div>
						}
						<button class="btn pri" type="submit">Sign in</button>
						<p class="small muted" style="margin:0">Forgot your password? Ask your admin to reset it.</p>
					</form>
				</div>
			</section>
		</div>
	}
}

templ Placeholder(title, active string) {
	@layout.Page(title, active) {
		<div class="head"><div><h1>{ title }</h1><p class="sub">Coming in the next milestone.</p></div></div>
	}
}
