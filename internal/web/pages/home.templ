package pages

import "github.com/ChandraShekar2001/application-tracker/internal/web/layout"

// Home is the milestone-1 placeholder: proves templ, static assets and the DB are wired.
templ Home(branches []string) {
	@layout.Page("Home", &layout.Shell{
		RoleLabel: "Skeleton",
		RoleClass: "role-other",
		UserName:  "Not signed in",
		UserEmail: "auth arrives in milestone 2",
		Items:     []layout.NavItem{{Key: "home", Label: "Home", Href: "/"}},
		Active:    "home",
	}) {
		<div class="head">
			<div>
				<h1>SNY Cosmos Application Tracker</h1>
				<p class="sub">The app skeleton is running.</p>
			</div>
		</div>
		<section class="card">
			<h2>Branches</h2>
			<p class="sub">Loaded from the database (seed migration).</p>
			<div class="row">
				for _, b := range branches {
					<span class="badge b-consultant">{ b }</span>
				}
			</div>
		</section>
	}
}

templ Error(status int, title, message string) {
	@layout.Page(title, nil) {
		<main style="max-width:560px;margin:80px auto;padding:0 16px">
			<div class="card">
				<h1>{ title }</h1>
				<p class="sub">{ message }</p>
				<p><a href="/">Back to the tracker</a></p>
			</div>
		</main>
	}
}
