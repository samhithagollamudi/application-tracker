package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/ChandraShekar2001/application-tracker/internal/model"
	"github.com/ChandraShekar2001/application-tracker/internal/web/components"
	"github.com/ChandraShekar2001/application-tracker/internal/web/layout"
)

func appMeta(a model.Application) string {
	var parts []string
	head := strings.Join(nonEmpty(model.LevelLabel(a.Level), a.Programme), " · ")
	if head != "" {
		parts = append(parts, head)
	}
	if a.Country != "" {
		parts = append(parts, a.Country)
	}
	if in := strings.TrimSpace(model.IntakeLabel(a.Intake) + " " + a.Year); in != "" {
		parts = append(parts, in)
	}
	parts = append(parts, a.Code())
	return strings.Join(parts, " · ")
}

func appSub(a model.Application) string {
	var parts []string
	if a.ApplicationNumber != "" {
		parts = append(parts, "Application no. "+a.ApplicationNumber)
	}
	if a.Priority != "" {
		parts = append(parts, "Priority "+a.Priority)
	}
	if a.SubmissionDate != "" {
		parts = append(parts, "Submitted "+model.FormatISODate(a.SubmissionDate))
	} else {
		parts = append(parts, "Not submitted yet")
	}
	return strings.Join(parts, " · ")
}

func afterAdmission(a model.Application) string {
	var parts []string
	if t := a.Tuition(); t != "" {
		parts = append(parts, "Tuition fee: "+t)
	}
	if a.Scholarship != "" {
		parts = append(parts, "Scholarship "+a.Scholarship)
	}
	if a.PersonalCode != "" {
		parts = append(parts, "Personal code "+a.PersonalCode)
	}
	return strings.Join(parts, " · ")
}

func nonEmpty(xs ...string) []string {
	var out []string
	for _, x := range xs {
		if x != "" {
			out = append(out, x)
		}
	}
	return out
}

func appURL(id int64, suffix string) string { return fmt.Sprintf("/applications/%d/%s", id, suffix) }

// AppCard is one application on the student page. The status select posts
// via htmx and the server returns a fresh card.
templ AppCard(a model.Application) {
	<article class="app" id={ fmt.Sprintf("app-%d", a.ID) }>
		<div class="row" style="justify-content:space-between;align-items:flex-start">
			<div style="display:flex;flex-direction:column;gap:4px">
				<h2>
					{ a.Uni }
					if a.Custom {
						<span class="badge b-other" style="vertical-align:middle">One-off</span>
					}
				</h2>
				<div class="muted">{ appMeta(a) }</div>
				<div class="small muted">{ appSub(a) }</div>
			</div>
			<label class="f" style="min-width:170px">
				Status
				<select
					name="status"
					hx-post={ appURL(a.ID, "status") }
					hx-trigger="change"
					hx-target={ fmt.Sprintf("#app-%d", a.ID) }
					hx-swap="outerHTML"
				>
					<option value="">—</option>
					for _, s := range model.Statuses {
						<option value={ s.Value } selected?={ s.Value == a.Status }>{ s.Label }</option>
					}
				</select>
			</label>
		</div>
		@components.Steps(a.Status)
		if x := afterAdmission(a); x != "" {
			<div class="small muted">{ x }</div>
		}
		<div class="row" style="justify-content:space-between;border-top:1px solid var(--line2);padding-top:12px">
			<span class="small muted">Updated { model.FormatDate(a.UpdatedAt) }</span>
			<div class="row">
				<form class="inline" method="post" action={ templ.SafeURL(appURL(a.ID, "delete")) } data-confirm={ "Delete the application to " + a.Uni + " (" + a.Code() + ")? This can’t be undone." }>
					@layout.CSRF()
					<button class="btn sm danger" type="submit">Delete</button>
				</form>
				<a class="btn sm blue" href={ templ.SafeURL(appURL(a.ID, "edit")) }>Edit application</a>
			</div>
		</div>
	</article>
}

func isCustom(f model.ApplicationFields) bool {
	return f.UniversityID == "" && f.UniOther != ""
}

// pickedCountry is the country of the list university already chosen ("" if none),
// so app.js can clear the choice when the Country dropdown changes.
func pickedCountry(f model.ApplicationFields) string {
	if f.UniversityID == "" {
		return ""
	}
	return f.CountryName
}

func currencyOptions() []model.Option {
	out := make([]model.Option, len(model.Currencies))
	for i, c := range model.Currencies {
		out[i] = model.Option{Value: c, Label: c}
	}
	return out
}

func orDefault(v, d string) string {
	if v == "" {
		return d
	}
	return v
}

// AppFields is the university + application section, used on its own form
// and (embedded) as the optional first application on the new-student form.
templ AppFields(vm AppFormVM, embedded bool) {
	<section class="card">
		if embedded {
			<h2>First application <span class="muted" style="font-weight:500;font-size:14px">(leave everything empty to skip)</span></h2>
		} else {
			<h2>University &amp; application</h2>
		}
		<div class="grid">
			<label class={ "f", templ.KV("has-err", vm.Errs["country"] != "") }>
				Country
				<select id="appCountry" name="country" data-app-country>
					<option value="">Select country</option>
					for _, c := range vm.Countries {
						<option value={ c } selected?={ c == vm.F.CountryName }>{ c }</option>
					}
				</select>
				if e := vm.Errs["country"]; e != "" {
					<span class="err">{ e }</span>
				}
			</label>
			<div class={ "f", "combo", templ.KV("has-err", vm.Errs["university"] != "") } data-combo>
				<label for="uniQ">University</label>
				<input
					id="uniQ"
					class="combo-q"
					name="uni_q"
					type="text"
					autocomplete="off"
					placeholder="Search university"
					value={ vm.F.UniversityName }
					role="combobox"
					aria-expanded="false"
					aria-controls="uniList"
					hidden?={ isCustom(vm.F) }
					hx-get="/catalog/universities/search"
					hx-trigger="focus, input changed delay:200ms"
					hx-target="#uniList"
					hx-include="#appCountry"
					hx-sync="this:replace"
				/>
				<input type="hidden" name="university_id" value={ vm.F.UniversityID } data-country={ pickedCountry(vm.F) }/>
				<input type="hidden" name="university_name" value={ vm.F.UniversityName }/>
				<div class="combo-list" id="uniList" role="listbox" hidden></div>
				<div class="combo-other" hidden?={ !isCustom(vm.F) } style="display:flex;flex-direction:column;gap:6px">
					<input name="uni_other" type="text" value={ vm.F.UniOther } placeholder="Type the university name" aria-label="University name (one-off)"/>
					<button type="button" class="lnk" data-combo-back style="align-self:flex-start">Back to the list</button>
				</div>
				if e := vm.Errs["university"]; e != "" {
					<span class="err">{ e }</span>
				}
			</div>
			@components.Select("Programme level", "programme_level", vm.F.Level, model.Levels, "Select", vm.Errs["programme_level"])
			@components.Field("Programme applied for", "programme", vm.F.Programme, "text", "", "", vm.Errs["programme"])
			<label class={ "f", templ.KV("has-err", vm.Errs["priority"] != "") }>
				Priority number
				<input name="priority" type="text" inputmode="numeric" pattern="[0-9]*" value={ vm.F.Priority } placeholder="If applicable" data-digits/>
				if e := vm.Errs["priority"]; e != "" {
					<span class="err">{ e }</span>
				}
			</label>
			@components.Select("Intake", "intake", vm.F.Intake, model.Intakes, "Select", vm.Errs["intake"])
			@components.Select("Year", "year", vm.F.Year, vm.Years, "Select", vm.Errs["year"])
			@components.Field("Application number", "application_number", vm.F.ApplicationNumber, "text", "", "", vm.Errs["application_number"])
			@components.Field("Submission date", "submission_date", vm.F.SubmissionDate, "date", "", "", vm.Errs["submission_date"])
			@components.Select("Status", "status", vm.F.Status, model.Statuses, "Select", vm.Errs["status"])
		</div>
		<details class="after" open?={ vm.F.HasAfterAdmission() || vm.Errs["tuition_fee"] != "" }>
			<summary>After admission</summary>
			<div class="grid" style="margin-top:12px">
				@components.Field("Personal code number (Sweden only)", "personal_code", vm.F.PersonalCode, "text", "", "", vm.Errs["personal_code"])
				@components.Field("Tuition fee", "tuition_fee", vm.F.TuitionFee, "text", "Amount, e.g. 120000", "", vm.Errs["tuition_fee"])
				@components.Select("Tuition fee currency", "tuition_currency", orDefault(vm.F.Currency, "EUR"), currencyOptions(), "", vm.Errs["tuition_currency"])
				@components.Select("Tuition fee is per", "tuition_per", vm.F.TuitionPer, model.TuitionPer, "Select", vm.Errs["tuition_per"])
				@components.Field("Scholarship", "scholarship", vm.F.Scholarship, "text", "Amount or %", "", vm.Errs["scholarship"])
			</div>
		</details>
		<p class="small muted" style="margin:0">For any non-partner university application, pick “Other” and type the university name.</p>
	</section>
}

templ AppForm(vm AppFormVM) {
	@layout.Page(vm.Title, "students") {
		<div class="head">
			<div>
				<h1>{ vm.Title }</h1>
				<p class="sub">{ vm.Student }</p>
			</div>
		</div>
		if len(vm.Errs) > 0 {
			<div class="notice warn" role="alert">Please fix the highlighted fields.</div>
		}
		<form method="post" action={ templ.SafeURL(vm.Action) } data-guard novalidate autocomplete="off" style="display:flex;flex-direction:column;gap:18px">
			@layout.CSRF()
			@AppFields(vm, false)
			<div class="card savebar">
				<a class="btn" href={ templ.SafeURL(vm.CancelHref) }>Cancel</a>
				<button class="btn pri" type="submit">{ vm.Submit }</button>
			</div>
		</form>
	}
}

// UniSearchResults is the htmx response for the university search box.
templ UniSearchResults(unis []model.University) {
	for _, u := range unis {
		<button type="button" role="option" data-pick={ strconv.FormatInt(u.ID, 10) } data-name={ u.Name } data-country={ u.Country }>
			{ u.Name }<span class="muted" style="font-weight:500">{ u.Country }</span>
		</button>
	}
	<button type="button" role="option" class="other" data-pick="__other">Other (not in the list)</button>
}
